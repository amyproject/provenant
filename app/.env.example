# All optional. With none set the app runs fully offline in fixture/stub mode (the demo mode).
NAIVE_API_KEY=
ANTHROPIC_API_KEY=
SAM_GOV_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SIGNING_PRIVATE_JWK=
NEXT_PUBLIC_USE_MOCKS=
# Agent pacing + autopilot (server heartbeat that advances cases without any clicks)
AGENT_AUTOPILOT=1
AGENT_TICK_MS=1500
AGENT_STEP_DELAY_MS=900
# Key-free public lookups (RDAP, CSL download) stay OFF in fixture mode unless set to 1
LIVE_PUBLIC_LOOKUPS=
# Where the local store + signing keys live (tests point this at a temp dir)
DATA_DIR=.data
# Optional live adapters / deployment
GOOGLE_MAPS_API_KEY=
IMPORTYETI_API_KEY=
PUBLIC_BASE_URL=
PROVENANT_PERSIST=
DEMO_ADMIN_TOKEN=
NAIVE_WEBHOOK_SECRET=
